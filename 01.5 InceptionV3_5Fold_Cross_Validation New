","RANDOM_STATE = 42\n","\n","label_column = 'label'\n","image_column = 'filename'\n","\n","BETA_1 = 0.9\n","BETA_2 = 0.999\n","EPSILON = 1e-7\n","\n","REDUCE_LR_FACTOR = 0.5\n","REDUCE_LR_PATIENCE = 3\n","MIN_LR = 1e-7\n","\n","TRANSFER_MODELS = {\n","    \"MobileNet\": {\n","        \"model\": MobileNet,\n","        \"preprocess\": mobilenet_preprocess,\n","        \"input_size\": (224, 224)\n","    },\n","    \"MobileNetV2\": {\n","        \"model\": MobileNetV2,\n","        \"preprocess\": mobilenetv2_preprocess,\n","        \"input_size\": (224, 224)\n","    },\n","    \"EfficientNetB0\": {\n","        \"model\": EfficientNetB0,\n","        \"preprocess\": efficientnet_preprocess,\n","        \"input_size\": (224, 224)\n","    },\n","    \"DenseNet121\": {\n","        \"model\": DenseNet121,\n","        \"preprocess\": densenet_preprocess,\n","        \"input_size\": (224, 224)\n","    },\n","    \"ResNet50\": {\n","        \"model\": ResNet50,\n","        \"preprocess\": resnet_preprocess,\n","        \"input_size\": (224, 224)\n","    },\n","    \"InceptionV3\": {\n","        \"model\": InceptionV3,\n","        \"preprocess\": inception_preprocess,\n","        \"input_size\": (299, 299)\n","    },\n","    \"Xception\": {\n","        \"model\": Xception,\n","        \"preprocess\": xception_preprocess,\n","        \"input_size\": (299, 299)\n","    },\n","    \"VGG16\": {\n","        \"model\": VGG16,\n","        \"preprocess\": vgg16_preprocess,\n","        \"input_size\": (224, 224)\n","    }\n","}\n","\n","# For faster testing, use only [\"MobileNet\"] first\n","BASE_MODEL_LIST = [\"InceptionV3\"]\n","\n","# BASE_MODEL_LIST = [\n","#     \"MobileNet\",\n","#     \"MobileNetV2\",\n","#     \"EfficientNetB0\",\n","#     \"DenseNet121\",\n","#     \"ResNet50\"\n","# ]\n","\n","HYPERPARAMETER_GRID = [\n","    {\n","        \"experiment\": \"Baseline_Frozen\",\n","        \"description\": \"Frozen pretrained convolutional base.\",\n","        \"learning_rate\": 1e-4,\n","        \"use_reduce_lr\": False,\n","        \"unfreeze_last_layers\": 0,\n","        \"dense_units\": 1024,\n","        \"dropout\": 0.5\n","    },\n","    {\n","        \"experiment\": \"HP1_LR1e4_Dropout05_Unfreeze50_ReduceLR\",\n","        \"description\": \"LR=1e-4, dropout=0.5, unfreeze last 50 layers, ReduceLROnPlateau.\",\n","        \"learning_rate\": 1e-4,\n","        \"use_reduce_lr\": True,\n","        \"unfreeze_last_layers\": 50,\n","        \"dense_units\": 1024,\n","        \"dropout\": 0.5\n","    },\n","    {\n","        \"experiment\": \"HP2_LR1e5_Dropout05_Unfreeze50_ReduceLR\",\n","        \"description\": \"LR=1e-5, dropout=0.5, unfreeze last 50 layers, ReduceLROnPlateau.\",\n","        \"learning_rate\": 1e-5,\n","        \"use_reduce_lr\": True,\n","        \"unfreeze_last_layers\": 50,\n","        \"dense_units\": 1024,\n","        \"dropout\": 0.5\n","    },\n","    {\n","        \"experiment\": \"HP3_LR1e4_Dropout03_Unfreeze50_ReduceLR\",\n","        \"description\": \"LR=1e-4, dropout=0.3, unfreeze last 50 layers, ReduceLROnPlateau.\",\n","        \"learning_rate\": 1e-4,\n","        \"use_reduce_lr\": True,\n","        \"unfreeze_last_layers\": 50,\n","        \"dense_units\": 1024,\n","        \"dropout\": 0.3\n","    },\n","    {\n","        \"experiment\": \"HP4_LR1e4_Dropout05_Unfreeze30_ReduceLR\",\n","        \"description\": \"LR=1e-4, dropout=0.5, unfreeze last 30 layers, ReduceLROnPlateau.\",\n","        \"learning_rate\": 1e-4,\n","        \"use_reduce_lr\": True,\n","        \"unfreeze_last_layers\": 30,\n","        \"dense_units\": 1024,\n","        \"dropout\": 0.5\n","    }\n","]"],"metadata":{"id":"0hJybFgJDmal","executionInfo":{"status":"ok","timestamp":1779525911774,"user_tz":-420,"elapsed":1276,"user":{"displayName":"Andi Sunyoto","userId":"05357195464847305593"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# BLOCK 4 — Helper Functions\n","# ============================================================\n","\n","class LearningRateLogger(Callback):\n","    def __init__(self):\n","        super().__init__()\n","        self.lr_history = []\n","\n","    def on_epoch_end(self, epoch, logs=None):\n","        lr = float(tf.keras.backend.get_value(self.model.optimizer.learning_rate))\n","        self.lr_history.append(lr)\n","        print(f\"Epoch {epoch + 1}: Learning Rate = {lr:.8f}\")\n","\n","\n","def load_and_preprocess_image(path, img_size, preprocess_func):\n","    img = load_img(os.path.join(DATASET_DIR, path), target_size=img_size)\n","    img = img_to_array(img).astype(np.float32)\n","    img = preprocess_func(img)\n","    return img\n","\n","\n","def load_raw_image(path, img_size):\n","    img = load_img(os.path.join(DATASET_DIR, path), target_size=img_size)\n","    img = img_to_array(img).astype(np.float32)\n","    return img\n","\n","\n","def load_dataset_with_cache(base_model_name, img_size, preprocess_func):\n","    # ✅ Shared cache by image size, not by transfer-learning model\n","    # Models with the same input size will reuse the same raw image cache.\n","    cache_file = os.path.join(\n","        BEST_MODEL_DIR,\n","        f\"cached_raw_dataset_{csv_File}_{img_size[0]}x{img_size[1]}.npz\"\n","    )\n","\n","    df = pd.read_csv(csv_path)\n","\n","    class_names = sorted(df[label_column].unique())\n","    label_to_index = {name: i for i, name in enumerate(class_names)}\n","    df['label_index'] = df[label_column].map(label_to_index)\n","\n","    print(\"Class names:\", class_names)\n","    print(\"Label-to-index mapping:\", label_to_index)\n","    print(\"Label distribution:\")\n","    print(df[label_column].value_counts())\n","\n","    if os.path.exists(cache_file):\n","        print(f\"✅ Loading shared raw cache from: {cache_file}\")\n","\n","        cached = np.load(cache_file, allow_pickle=True)\n","\n","        X_raw = cached[\"X_raw\"].astype(np.float32)\n","        y = cached[\"y\"]\n","        class_names = cached[\"class_names\"].tolist()\n","\n","        label_to_index = {name: i for i, name in enumerate(class_names)}\n","        y_cat = to_categorical(y, num_classes=len(class_names))\n","\n","    else:\n","        print(f\"⚠️ Shared raw cache not found for size {img_size}. Loading raw images...\")\n","\n","        X_raw = np.array([\n","            load_raw_image(p, img_size)\n","            for p in df[image_column]\n","        ], dtype=np.float32)\n","\n","        y = df['label_index'].values\n","        y_cat = to_categorical(y, num_classes=len(class_names))\n","\n","        np.savez(\n","            cache_file,\n","            X_raw=X_raw,\n","            y=y,\n","            class_names=np.array(class_names)\n","        )\n","\n","        print(f\"✅ Shared raw cache saved to: {cache_file}\")\n","\n","    # ✅ Apply model-specific preprocessing AFTER loading shared raw cache\n","    print(f\"✅ Applying preprocessing for: {base_model_name}\")\n","\n","    X = preprocess_func(X_raw.copy()).astype(np.float32)\n","\n","    print(\"X_raw shape:\", X_raw.shape)\n","    print(\"X preprocessed shape:\", X.shape)\n","    print(\"y shape:\", y.shape)\n","    print(\"y_cat shape:\", y_cat.shape)\n","\n","    return df, X, y, y_cat, class_names, label_to_index\n","\n","def calculate_gflops(model, input_shape):\n","    dummy_input = tf.random.normal(input_shape)\n","    concrete_func = tf.function(model).get_concrete_function(dummy_input)\n","    options = ProfileOptionBuilder.float_operation()\n","    flops_result = profile(concrete_func.graph, options=options)\n","    total_flops = flops_result.total_float_ops\n","    return total_flops / 1e9\n","\n","\n","def measure_inference_gflops(model, input_data, gflops):\n","    start = time.time()\n","    predictions = model.predict(input_data, verbose=0)\n","    end = time.time()\n","\n","    inference_time = end - start\n","    gflops_total = gflops * len(input_data)\n","    gflops_per_sec = gflops_total / inference_time if inference_time > 0 else 0\n","\n","    return predictions, inference_time, gflops_total, gflops_per_sec\n","\n","\n","def generate_statistical_summary(accuracies):\n","    acc_mean = np.mean(accuracies)\n","    acc_std = np.std(accuracies)\n","    t_stat, p_val = ttest_1samp(accuracies, 0.5)\n","\n","    return pd.DataFrame([{\n","        'Accuracy Mean': acc_mean,\n","        'Accuracy StdDev': acc_std,\n","        'T-statistic vs 0.5': t_stat,\n","        'P-value vs 0.5': p_val\n","    }])\n","\n","\n","def build_transfer_model(base_model_class, input_shape, class_names, config):\n","    base_model = base_model_class(\n","        input_shape=input_shape,\n","        include_top=False,\n","        weights='imagenet'\n","    )\n","\n","    total_layers = len(base_model.layers)\n","    unfreeze_layers = min(config[\"unfreeze_last_layers\"], total_layers)\n","\n","    if unfreeze_layers == 0:\n","        for layer in base_model.layers:\n","            layer.trainable = False\n","    else:\n","        for layer in base_model.layers[:-unfreeze_layers]:\n","            layer.trainable = False\n","\n","        for layer in base_model.layers[-unfreeze_layers:]:\n","            layer.trainable = True\n","\n","    x = base_model.output\n","    x = GlobalAveragePooling2D()(x)\n","    x = Dense(config[\"dense_units\"], activation='relu')(x)\n","    x = Dropout(config[\"dropout\"])(x)\n","    output = Dense(len(class_names), activation='softmax')(x)\n","\n","    model = Model(inputs=base_model.input, outputs=output)\n","\n","    optimizer = tf.keras.optimizers.Adam(\n","        learning_rate=config[\"learning_rate\"],\n","        beta_1=BETA_1,\n","        beta_2=BETA_2,\n","        epsilon=EPSILON\n","    )\n","\n","    model.compile(\n","        optimizer=optimizer,\n","        loss='categorical_crossentropy',\n","        metrics=[\n","            'accuracy',\n","            tf.keras.metrics.AUC(name='auc')\n","        ]\n","    )\n","\n","    return model"],"metadata":{"id":"AKO3yxscDpOA","executionInfo":{"status":"ok","timestamp":1779525911811,"user_tz":-420,"elapsed":25,"user":{"displayName":"Andi Sunyoto","userId":"05357195464847305593"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# BLOCK 5 — Figure Functions\n","# ============================================================\n","\n","def save_high_resolution_confusion_matrix(y_true, y_pred, class_names, experiment_full_name, fold):\n","    plt.figure(figsize=(10, 8), dpi=300)\n","\n","    sns.heatmap(\n","        confusion_matrix(y_true, y_pred),\n","        annot=True,\n","        fmt='d',\n","        xticklabels=class_names,\n","        yticklabels=class_names,\n","        cmap='Blues',\n","        annot_kws={\"size\": 14}\n","    )\n","\n","    plt.title(f'{experiment_full_name} - Fold {fold} - Test Confusion Matrix', fontsize=16)\n","    plt.xlabel('Predicted', fontsize=14)\n","    plt.ylabel('Actual', fontsize=14)\n","    plt.xticks(fontsize=12, rotation=45)\n","    plt.yticks(fontsize=12, rotation=0)\n","    plt.tight_layout()\n","\n","    save_path = os.path.join(BEST_MODEL_DIR, f\"{experiment_full_name}_fold_{fold}_confusion_matrix.png\")\n","    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","\n","def save_high_resolution_training_curve(history, experiment_full_name, fold):\n","    plt.figure(figsize=(14, 6), dpi=300)\n","\n","    ax1 = plt.subplot(1, 2, 1)\n","    ax1.plot(history.history['loss'], label='Train Loss')\n","    ax1.plot(history.history['val_loss'], label='Validation Loss')\n","    ax1.set_title(f'Fold {fold} - Loss', fontsize=16)\n","    ax1.set_xlabel('Epochs', fontsize=14)\n","    ax1.set_ylabel('Loss', fontsize=14)\n","    ax1.set_xlim(0, EPOCHS)\n","    ax1.xaxis.set_major_locator(MaxNLocator(integer=True))\n","    ax1.grid(True)\n","    ax1.legend(fontsize=12)\n","\n","    ax2 = plt.subplot(1, 2, 2)\n","    ax2.plot(history.history['accuracy'], label='Train Accuracy')\n","    ax2.plot(history.history['val_accuracy'], label='Validation Accuracy')\n","    ax2.set_title(f'Fold {fold} - Accuracy', fontsize=16)\n","    ax2.set_xlabel('Epochs', fontsize=14)\n","    ax2.set_ylabel('Accuracy', fontsize=14)\n","    ax2.set_xlim(0, EPOCHS)\n","    ax2.set_ylim(0, 1)\n","    ax2.xaxis.set_major_locator(MaxNLocator(integer=True))\n","    ax2.grid(True)\n","    ax2.legend(fontsize=12)\n","\n","    plt.tight_layout()\n","\n","    save_path = os.path.join(BEST_MODEL_DIR, f\"{experiment_full_name}_fold_{fold}_training_curve.png\")\n","    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","\n","def save_high_resolution_roc_curve(y_test, test_preds, class_names, experiment_full_name, fold):\n","    plt.figure(figsize=(10, 8), dpi=300)\n","\n","    for i, class_name in enumerate(class_names):\n","        fpr, tpr, _ = roc_curve(y_test[:, i], test_preds[:, i])\n","        auc_val = roc_auc_score(y_test[:, i], test_preds[:, i])\n","        plt.plot(fpr, tpr, label=f'{class_name} AUC = {auc_val:.2f}')\n","\n","    plt.plot([0, 1], [0, 1], 'k--', label='Random Classifier')\n","    plt.title(f'{experiment_full_name} - Fold {fold} - Test ROC Curves', fontsize=16)\n","    plt.xlabel('False Positive Rate', fontsize=14)\n","    plt.ylabel('True Positive Rate', fontsize=14)\n","    plt.xlim(0, 1)\n","    plt.ylim(0, 1)\n","    plt.legend(loc='lower right', fontsize=12)\n","    plt.grid(True)\n","    plt.tight_layout()\n","\n","    save_path = os.path.join(BEST_MODEL_DIR, f\"{experiment_full_name}_fold_{fold}_roc_curve.png\")\n","    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","\n","def save_learning_rate_plot(lr_history, experiment_full_name, fold):\n","    plt.figure(figsize=(8, 6), dpi=300)\n","\n","    plt.plot(range(1, len(lr_history) + 1), lr_history, marker='o')\n","    plt.title(f'{experiment_full_name} - Fold {fold} Learning Rate Schedule', fontsize=16)\n","    plt.xlabel('Epoch', fontsize=14)\n","    plt.ylabel('Learning Rate', fontsize=14)\n","    plt.grid(True)\n","    plt.tight_layout()\n","\n","    save_path = os.path.join(BEST_MODEL_DIR, f\"{experiment_full_name}_fold_{fold}_learning_rate_schedule.png\")\n","    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n","    plt.show()"],"metadata":{"id":"60jjjd-JDtl4","executionInfo":{"status":"ok","timestamp":1779525911828,"user_tz":-420,"elapsed":15,"user":{"displayName":"Andi Sunyoto","userId":"05357195464847305593"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# BLOCK 6 — Run Multi-Backbone Hyperparameter Experiments\n","# Saves ONLY ONE BEST MODEL across 5 folds per experiment\n","# ============================================================\n","\n","all_summary_rows = []\n","all_statistics_rows = []\n","all_prediction_logs = []\n","all_time_logs = []\n","all_gflops_logs = []\n","all_fold_assignments = []\n","all_training_configs = []\n","all_lr_logs = []\n","experiment_accuracy_dict = {}\n","\n","for base_model_name in BASE_MODEL_LIST:\n","\n","    print(\"\\n####################################################\")\n","    print(f\"🧠 Loading Dataset for Base Model: {base_model_name}\")\n","    print(\"####################################################\")\n","\n","    model_info = TRANSFER_MODELS[base_model_name]\n","    base_model_class = model_info[\"model\"]\n","    preprocess_func = model_info[\"preprocess\"]\n","    img_size = model_info[\"input_size\"]\n","    input_shape = (*img_size, 3)\n","\n","    df, X, y, y_cat, class_names, label_to_index = load_dataset_with_cache(\n","        base_model_name=base_model_name,\n","        img_size=img_size,\n","        preprocess_func=preprocess_func\n","    )\n","\n","    skf = StratifiedKFold(\n","        n_splits=N_SPLITS,\n","        shuffle=True,\n","        random_state